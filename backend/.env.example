# Backend server port
PORT=3001


# Supabase Database URL 
DATABASE_URL=
# Background keep-alive task interval in hours (pings Supabase DB to prevent free-tier pausing)
KEEP_ALIVE_INTERVAL_HOURS=48

# Frontend URL (for CORS setup)
FRONTEND_URL=http://localhost:5173

# Node environment (development, production)
NODE_ENV=development

# Supabase JWT Secret (found in Project Settings -> API)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
