# Backend server port
PORT=3001

# PostgreSQL database connection string (e.g., Neon Postgres connection URI)
DATABASE_URL=postgresql://username:password@hostname:port/dbname?sslmode=require

# Frontend URL (for CORS setup)
FRONTEND_URL=http://localhost:5173

# Node environment (development, production)
NODE_ENV=development

# Supabase JWT Secret (for verifying client JWTs, if applicable)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
